{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudForge runtime configuration v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1alpha1"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "port"
      ]
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "health": {
          "type": "string"
        },
        "readiness": {
          "type": "string"
        },
        "load": {
          "type": "string"
        }
      },
      "required": []
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "duration": {
          "type": "string"
        }
      },
      "required": [
        "vus",
        "duration"
      ]
    },
    "experiments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_path": {
          "type": "string"
        }
      },
      "required": []
    }
  },
  "required": [
    "schema_version",
    "runtime",
    "endpoints",
    "load",
    "experiments"
  ]
}
